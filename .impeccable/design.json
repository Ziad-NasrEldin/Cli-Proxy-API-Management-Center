  "narrative": {
    "northStar": "Account ledger",
    "overview": "API Hub retains its existing logo and warm neutral light/dark themes. The quota surface uses a compact account ledger: identity, capacity and actions remain easy to compare, with secondary information disclosed on demand. This is a record of the implemented existing-theme design, not a newly selected brand identity.",
    "keyCharacteristics": [
      "Warm neutral surfaces with restrained borders.",
      "Full account identities and explicit quota semantics.",
      "Compact desktop rows that stack on smaller screens."
    ],
    "rules": [
      {
        "name": "Meaning Before Color",
        "body": "Label remaining capacity and each time window explicitly; color supplements the numbers.",
        "section": "colors"
      },
      {
        "name": "Full Identity",
        "body": "Account identifiers wrap instead of truncating. Keep the subscription beside the provider metadata.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use the existing API Hub logo and theme variables.",
      "Do show five-hour and weekly limits separately, with countdown and exact reset time when reported.",
      "Do keep action feedback visible beside actions while secondary grant details stay collapsed."
    ],
    "donts": [
      "Don't substitute zero for unavailable provider data.",
      "Don't clip account identities, quota labels or reset times.",
      "Don't promote provider colors into competing page backgrounds."
    ]
  }
